; Solarpunk, tempered -- the active theme (DEC-033). Ratified in
; docs/design/Visual Language.md; that document owns every value here, this
; file only carries them.
;
; Rule 3: no UI element may be more saturated than `accent`. New colours are
; proposed against that rule, not added beside it.
[gd_resource type="Theme" load_steps=4 format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_surface"]
; `surface` overlay, rule 2: alpha 0.92, never below the 0.80 floor -- holds
; AA for `text_primary` against any backdrop, not just this palette's own
; `background`.
bg_color = Color(0.117647, 0.133333, 0.098039, 0.92)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_primary_button_normal"]
bg_color = Color(0.752941, 0.541176, 0.278431, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_disabled"]
; `disabled_surface` -- fills and borders of inactive controls (rule 4). Kept
; distinct from `surface` so an unavailable ingredient stays a recognisably
; different fill, not merely dim.
bg_color = Color(0.203922, 0.227451, 0.172549, 1)

[resource]

Tokens/colors/background = Color(0.070588, 0.078431, 0.058824, 1)
Tokens/colors/surface = Color(0.117647, 0.133333, 0.098039, 1)
Tokens/colors/text_primary = Color(0.929412, 0.909804, 0.850980, 1)
Tokens/colors/text_muted = Color(0.556863, 0.580392, 0.509804, 1)
Tokens/colors/accent = Color(0.752941, 0.541176, 0.278431, 1)
Tokens/colors/signal = Color(0.615686, 0.705882, 0.627451, 1)
Tokens/colors/disabled_surface = Color(0.203922, 0.227451, 0.172549, 1)
Tokens/colors/disabled_text = Color(0.419608, 0.450980, 0.376471, 1)
Tokens/constants/spacing_unit = 8
Tokens/font_sizes/request = 20
Tokens/font_sizes/body = 16
Tokens/font_sizes/label = 13

Button/colors/font_color = Color(0.929412, 0.909804, 0.850980, 1)
Button/colors/font_disabled_color = Color(0.419608, 0.450980, 0.376471, 1)
Button/font_sizes/font_size = 16
Button/styles/disabled = SubResource("StyleBoxFlat_button_disabled")

PrimaryButton/base_type = &"Button"
PrimaryButton/colors/font_color = Color(0.070588, 0.078431, 0.058824, 1)
PrimaryButton/styles/normal = SubResource("StyleBoxFlat_primary_button_normal")

Label/colors/font_color = Color(0.929412, 0.909804, 0.850980, 1)
Label/font_sizes/font_size = 16

GroupHeading/base_type = &"Label"
GroupHeading/font_sizes/font_size = 13

RichTextLabel/colors/default_color = Color(0.929412, 0.909804, 0.850980, 1)
RichTextLabel/font_sizes/normal_font_size = 16

RequestText/base_type = &"RichTextLabel"
RequestText/font_sizes/normal_font_size = 20

Panel/styles/panel = SubResource("StyleBoxFlat_surface")
PanelContainer/styles/panel = SubResource("StyleBoxFlat_surface")

HBoxContainer/constants/separation = 24
VBoxContainer/constants/separation = 24
