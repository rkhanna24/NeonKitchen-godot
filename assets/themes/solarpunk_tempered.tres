Button/styles/hover = SubResource("StyleBoxFlat_button_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_button_hover")
Button/styles/focus = SubResource("StyleBoxFlat_button_focus")
Button/styles/disabled = SubResource("StyleBoxFlat_button_disabled")

PrimaryButton/base_type = &"Button"
PrimaryButton/colors/font_color = Color(0.070588, 0.078431, 0.058824, 1)
