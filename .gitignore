# Godot 4+ specific ignores
.godot/
/android/

# Godot .uid sidecar files are NOT ignored. They are engine-internal reference
# plumbing and must be committed -- see AGENTS.md rule 11.

# Addons are fetched by scripts/setup.sh, not committed. Godot has no package
# manager, so that script is ours: it pins an exact commit and verifies it.
# See docs/adr/0003-test-framework.md.
/addons/

# Godot regenerates .translation resources from their source .csv on import,
# byte-identically, so they are build output. The .csv and its .import descriptor
# are committed; these are not.
*.translation

# Python development environment (gdtoolkit). Pinned in requirements-dev.txt.
.venv/
__pycache__/

# Content-crew handoff files. The proposal, balance report and verification report
# agents pass between each other, plus the packet mirrored from the issue. Scratch
# by the same reasoning as crew-runs below: the durable record is the commit, the
# ADR, or the issue. The .gdignore is tracked; the handoffs are not.
/content/staging/*.md

# Content-crew run artifacts: the proposal, balance report, verification report
# and acceptance note a crew run hands between its agents. Scratch working notes,
# not durable records — anything worth keeping belongs in a commit message, an
# ADR, or a GitHub issue (DEC-014). Ignoring them also keeps tools/run_crew.sh
# from poisoning its own dirty-tree guard on a second run.
/docs/worklogs/crew-runs/

# OS / editor artifacts
.DS_Store
*.swp

# Reference-research tooling. The human's review site is a Next.js app that
# happens to live under docs/design/references/; it is not project source, it
# carries its own node_modules and build output, and one of its scaffold
# directories is empty, which fails the layout gate. The durable artefacts are
# the notes and screenshots beside it, not the viewer.
/docs/design/references/review-site/

# Reference screenshots. Copyrighted frames from commercial games, kept locally
# as design evidence and cited by name in docs/design/references/*.md so a reader
# can find the same frame themselves. The durable artefact is the analysis, not
# the image, and this repository is public.
/docs/design/references/*.jpg
/docs/design/references/*.png
/docs/design/references/*.jpeg

# Working research notes kept local by the human's decision: the raw matrix,
# source index, and superseded framing hypotheses. The conclusions they fed into
# are committed in frame-notes-and-greybox-brief.md and godot-greybox-ideas.md.
/docs/design/references/framing-hypotheses.md
/docs/design/references/research-matrix.md
/docs/design/references/source-index.md
/docs/design/references/README.md
